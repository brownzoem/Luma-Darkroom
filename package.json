{
  "name": "luma-darkroom",
  "version": "3.0.0",
  "description": "A local-first, non-destructive desktop photo workspace",
  "main": "electron/main.js",
  "author": "Luma Darkroom contributors",
  "license": "MIT",
  "homepage": "https://lumadarkroom.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brownzoem/Luma-Darkroom.git"
  },
  "bugs": {
    "url": "https://github.com/brownzoem/Luma-Darkroom/issues"
  },
  "keywords": [
    "photo-editor",
    "non-destructive-editing",
    "electron",
    "open-source"
  ],
  "scripts": {
    "build:icons": "node scripts/build-icons.js",
    "build:native-source": "node scripts/build-native-source-bundle.js",
    "build:notices": "node scripts/build-notice-bundle.js",
    "lint": "eslint .",
    "check:syntax": "node --check electron/main.js && node --check electron/preload.js && node --check electron/model-manager.js && node --check electron/custom-presets.js && node --check src/engine.js && node --check src/render-worker.js && node --check src/preview-worker.js && node --check src/ai-client.js && node --check src/ai-segmentation-worker.js && node --check src/app.js && node --check src/tools.js && node --check src/crop-tool.js",
    "test:smoke": "node tests/e2e-smoke.js",
    "test:regression": "node tests/e2e-regression.js",
    "test:resilience": "node tests/e2e-resilience.js",
    "test:interaction": "node tests/e2e-interaction-quality.js",
    "test:brush-workflow": "node tests/e2e-brush-workflow.js",
    "test:legacy-migration": "node tests/e2e-legacy-edit-migration.js",
    "test:layered-tools": "node tests/e2e-layered-tools.js",
    "test:selection-tools": "node tests/e2e-selection-tools.js",
    "test:crop-transform": "node tests/e2e-crop-transform.js",
    "test:keyboard-accessibility": "node tests/e2e-keyboard-accessibility.js",
    "test:export-worker": "node tests/e2e-export-worker.js",
    "test:model-manager": "node --test tests/model-manager.test.js",
    "test:semantic-masks": "node tests/e2e-semantic-masks.js",
    "test:ai-segmentation": "node tests/e2e-ai-segmentation.js",
    "test:point-color": "node tests/e2e-point-color-legacy-contract.js",
    "test:custom-presets": "node --test tests/custom-presets-validation.test.js && node tests/e2e-custom-presets.js",
    "test:feature-parity": "node --test tests/feature-parity-contract.test.js",
    "test:packaged": "node tests/packaged-smoke.js",
    "test:packaged-asar": "set LUMA_PACKAGED_ASAR=1&& node tests/packaged-smoke.js",
    "test": "npm run check:syntax && npm run lint && npm run test:feature-parity && npm run test:model-manager && npm run test:semantic-masks && npm run test:ai-segmentation && npm run test:point-color && npm run test:custom-presets && npm run test:smoke && npm run test:regression && npm run test:resilience && npm run test:interaction && npm run test:brush-workflow && npm run test:legacy-migration && npm run test:layered-tools && npm run test:selection-tools && npm run test:crop-transform && npm run test:keyboard-accessibility && npm run test:export-worker",
    "verify:notices": "node scripts/fetch-upstream-notices.js --check",
    "verify:notices:upstream": "node scripts/fetch-upstream-notices.js --check-upstream",
    "verify:release": "node scripts/verify-windows-release.js",
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.5",
    "playwright-core": "^1.62.1"
  },
  "build": {
    "appId": "com.luma.darkroom",
    "productName": "Luma Darkroom",
    "directories": {
      "output": "outputs/release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/icon.png",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json",
      "!node_modules/**/*.map",
      "!node_modules/**/docs/**"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/LUMA-DARKROOM-MIT.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "node_modules/sharp/LICENSE",
        "to": "licenses/sharp/Apache-2.0.txt"
      },
      {
        "from": "node_modules/@img/sharp-win32-x64/LICENSE",
        "to": "licenses/sharp-win32-x64/Apache-2.0.txt"
      },
      {
        "from": "node_modules/@img/sharp-win32-x64/README.md",
        "to": "licenses/sharp-win32-x64/NATIVE-LIBRARY-NOTICES.md"
      },
      {
        "from": "node_modules/@img/colour/LICENSE.md",
        "to": "licenses/colour/LICENSES.md"
      },
      {
        "from": "third_party",
        "to": "licenses/third_party",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Luma-Darkroom-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "license": "LICENSE",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "onnxruntime-web": "1.27.0",
    "sharp": "^0.35.3"
  }
}
